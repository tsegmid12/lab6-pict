{
  "info": {
    "name": "Lab 06 — POST /transfer Combinatorial Verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "T01 — Happy Path (USD to MNT transfer)",
      "item": [
        {
          "name": "1. Setup Sender ACC_A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup ACC_A status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Setup ACC_A result is OK', function () {",
                  "    pm.expect(pm.response.json().result).to.eql('OK');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"balance\": 1000000,\n  \"currency\": \"MNT\",\n  \"frozen\": false,\n  \"dailyLimit\": 500000,\n  \"usedToday\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/ACC_A",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "ACC_A"]
            }
          }
        },
        {
          "name": "2. Setup Recipient ACC_B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Setup ACC_B status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Setup ACC_B result is OK', function () {",
                  "    pm.expect(pm.response.json().result).to.eql('OK');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"balance\": 0,\n  \"currency\": \"MNT\",\n  \"frozen\": false,\n  \"dailyLimit\": 500000,\n  \"usedToday\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts/ACC_B",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "ACC_B"]
            }
          }
        },
        {
          "name": "3. Execute Transfer (T01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('T01 status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('T01 result is OK', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.result).to.eql('OK');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"ACC_A\",\n  \"to\": \"ACC_B\",\n  \"amount\": 100,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["transfer"]
            }
          }
        },
        {
          "name": "4. Verify Sender Balance After Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sender ACC_A balance reduced by 340,000 MNT', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.eql(660000);",
                  "    pm.expect(json.usedToday).to.eql(340000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/ACC_A",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "ACC_A"]
            }
          }
        },
        {
          "name": "5. Verify Recipient Balance After Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Recipient ACC_B balance increased by 340,000 MNT', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.eql(340000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/ACC_B",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "ACC_B"]
            }
          }
        }
      ]
    },
